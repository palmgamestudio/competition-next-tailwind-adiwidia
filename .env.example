# ===========================================
# Adiwidia — Environment Variables
# Copy ke .env.local lalu isi nilai aslinya
# ===========================================

# --- Supabase (client-side, wajib) ---
# Project URL dari Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Client key (aman untuk browser). Isi salah satu:
# - Publishable key baru: sb_publishable_...  (disarankan)
# - Legacy anon key: eyJ... JWT
# Nama env tetap ANON_KEY karena supabase-js pakai slot yang sama.
# Jangan pakai service_role / sb_secret_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key-here

# --- Google Gemini (server-side, wajib untuk Chat AI) ---
# API key dari Google AI Studio: https://aistudio.google.com/apikey
# Dipakai di /api/chat (default model: gemini-2.0-flash)
GEMINI_API_KEY=your-gemini-api-key

# Opsional — override model Gemini
# GEMINI_MODEL=gemini-2.0-flash
